# ROS Catkin build artifacts
/robot-src/catkin_ws/build/
/robot-src/catkin_ws/devel/
/robot-src/catkin_ws/install/
/robot-src/catkin_ws/log/
/wsl-simulation/build/
/wsl-simulation/devel/
/wsl-simulation/.catkin_workspace

# Python bytecode
__pycache__/
*.py[cod]

# Local temporary files
/tmp/*
!/tmp/.gitkeep

# Large training datasets: track metadata or manifests separately if needed
/datasets/yolo/*
!/datasets/yolo/.gitkeep
!/datasets/yolo/best.onnx
!/datasets/yolo/abcd/
/datasets/ocr/*
!/datasets/ocr/.gitkeep

# Sensitive machine information
/robot-information/private/

# Training artifacts
/runs/*
!/runs/abcd/
/yolo*.pt
!/yolo26n.pt
!/yolov8n.pt

# Robot disk images (too large to track)
/dogimage/

# Simulation debug logs
/*.log
