<launch>
  <!-- Captures 600 images at 0.5-second intervals by default. -->
  <arg name="camera_index" default="0" />
  <arg name="output_dir" default="$(env HOME)/yolo_dataset/images" />
  <arg name="image_count" default="600" />
  <arg name="interval" default="0.5" />
  <arg name="image_width" default="0" />
  <arg name="image_height" default="0" />
  <arg name="max_frame_failures" default="20" />

  <node pkg="robot_dog_yolo_dataset"
        type="yolo_image_collector.py"
        name="yolo_image_collector"
        output="screen">
    <param name="camera_index" value="$(arg camera_index)" />
    <param name="output_dir" value="$(arg output_dir)" />
    <param name="image_count" value="$(arg image_count)" />
    <param name="interval" value="$(arg interval)" />
    <param name="image_width" value="$(arg image_width)" />
    <param name="image_height" value="$(arg image_height)" />
    <param name="max_frame_failures" value="$(arg max_frame_failures)" />
  </node>
</launch>
