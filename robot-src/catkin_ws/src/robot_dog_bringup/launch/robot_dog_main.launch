<launch>
  <!-- Robot main bringup: runs on the physical device's ROS container and
       connects to the LOCAL rosmaster on the control PC.  Publishes map,
       lidar, camera and robot state; move_base + cym_planner drives the dog
       through the OUMAX cmd_vel bridge. -->
  <arg name="local_master_ip" default="192.168.137.232"/>
  <arg name="map_file" default="$(find robot_dog_navigation)/maps/ricam_arena.yaml"/>
  <arg name="enable_motion" default="false"/>
  <!-- Mapping mode: run slam_gmapping instead of map_server + move_base so
       /map has a single publisher while a map is being built with keyboard
       teleop (rosrun robot_dog_teleop mapping_keyboard_teleop.py).  In
       mapping mode pass init_x:=0.0 init_y:=0.0 so odom starts at the
       robot's physical position. -->
  <arg name="enable_mapping" default="false"/>
  <!-- Odom origin: mapping starts at the robot's physical position (0,0);
       navigation mode reuses the arena pose used in offline sim. -->
  <arg name="init_x" default="-0.70"/>
  <arg name="init_y" default="1.00"/>

  <env name="ROS_MASTER_URI" value="http://$(arg local_master_ip):11311"/>
  <env name="ROS_IP" value="192.168.137.157"/>

  <group unless="$(arg enable_mapping)">
    <node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)" output="screen"/>
  </group>

  <group if="$(arg enable_mapping)">
    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
      <remap from="scan" to="/scan_filtered"/>
      <param name="base_frame" value="base_link"/>
      <param name="odom_frame" value="odom"/>
      <param name="map_frame" value="map"/>
      <param name="map_update_interval" value="2.0"/>
      <param name="maxUrange" value="4.0"/>
      <param name="maxRange" value="12.0"/>
      <param name="minimumScore" value="30"/>
      <param name="particles" value="30"/>
      <param name="iterations" value="5"/>
      <param name="srr" value="0.05"/>
      <param name="srt" value="0.10"/>
      <param name="str" value="0.10"/>
      <param name="stt" value="0.20"/>
      <param name="linearUpdate" value="0.10"/>
      <param name="angularUpdate" value="0.20"/>
      <param name="xmin" value="-1.5"/>
      <param name="ymin" value="-1.25"/>
      <param name="xmax" value="1.5"/>
      <param name="ymax" value="1.25"/>
      <param name="delta" value="0.02"/>
    </node>
  </group>

  <!-- Dead-reckoning odometry: integrates /cmd_vel into odom -> base_link TF
       so move_base / cym_planner see the robot move.  In navigation mode the
       map -> odom TF is published by lidar_loc below; in mapping mode
       slam_gmapping publishes it, so no static map_to_odom exists here
       (a static publisher would fight whichever node owns that transform). -->
  <node pkg="robot_dog_navigation" type="simple_odom.py"
        name="simple_odom" output="screen">
    <param name="init_x" value="$(arg init_x)"/>
    <param name="init_y" value="$(arg init_y)"/>
    <param name="init_yaw" value="0.0"/>
    <param name="cmd_vel_topic" value="/cmd_vel"/>
    <param name="odom_topic" value="/odom"/>
  </node>
  <!-- Dynamic base_link -> laser_frame TF (published on /tf, not /tf_static):
       gmapping uses tf1 and never reads /tf_static. -->
  <node pkg="robot_dog_navigation" type="laser_frame_tf.py"
        name="laser_frame_tf" output="screen">
    <param name="parent_frame" value="base_link"/>
    <param name="child_frame" value="laser_frame"/>
    <param name="x" value="0.16"/>
    <param name="y" value="0.0"/>
    <param name="z" value="0.15"/>
    <param name="rate" value="10.0"/>
  </node>

  <node pkg="robot_dog_lidar" type="ydlidar_scan_node" name="ydlidar_scan" output="screen">
    <param name="baudrate" value="230400"/>
    <param name="frame_id" value="laser_frame"/>
    <param name="test_duration_sec" value="0"/>
  </node>

  <node pkg="robot_dog_navigation" type="scan_circle_filter.py"
        name="scan_circle_filter" output="screen">
    <param name="scan_topic" value="/scan"/>
    <param name="filtered_topic" value="/scan_filtered"/>
    <param name="center_x" value="0.0"/>
    <param name="center_y" value="0.0"/>
    <param name="radius" value="0.45"/>
    <param name="sector_center_deg" value="0.0"/>
    <param name="sector_half_width_deg" value="30.0"/>
    <param name="sector_max_range" value="1.0"/>
  </node>

  <node pkg="robot_dog_navigation" type="scan_to_cloud_and_body.py"
        name="scan_to_cloud_and_body" output="screen">
    <param name="scan_topic" value="/scan_filtered"/>
    <param name="cloud_topic" value="/lidar_points"/>
    <param name="body_length" value="0.27"/>
    <param name="body_width" value="0.16"/>
    <param name="body_height" value="0.10"/>
  </node>

  <node pkg="ricam_dataset_capture" type="mjpeg_bridge.py" name="mjpeg_bridge" output="screen">
    <param name="mjpeg_url" value="http://127.0.0.1:8090/stream.mjpg"/>
    <param name="image_topic" value="/camera/rgb/image_raw"/>
  </node>

  <group unless="$(arg enable_mapping)">
    <!-- Scan-matching localization (jie_ware lidar_loc): publishes map ->
         odom TF at ~30 Hz from the /scan_filtered scan matched against
         /map.  It resets to the map origin on the first map message, so
         initial_pose_publisher re-publishes the RICAM offline pose after the
         map arrives (initialpose callback also clears costmaps ~30 scans
         later).  Keep this node paired with initial_pose_publisher: never
         restart lidar_loc alone, or it will sit at the map origin. -->
    <node pkg="jie_ware" type="lidar_loc" name="lidar_loc" output="screen">
      <param name="base_frame" value="base_link"/>
      <param name="odom_frame" value="odom"/>
      <param name="laser_frame" value="laser_frame"/>
      <param name="laser_topic" value="/scan_filtered"/>
    </node>
    <node pkg="robot_dog_navigation" type="initial_pose_publisher.py"
          name="initial_pose_publisher" output="screen">
      <param name="init_x" value="$(arg init_x)"/>
      <param name="init_y" value="$(arg init_y)"/>
      <param name="init_yaw" value="0.0"/>
    </node>
    <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find robot_dog_navigation)/config/move_base.yaml" command="load"/>
    <rosparam file="$(find cym_planner)/config/cym_planner_params.json" command="load"/>
    <rosparam file="$(find robot_dog_navigation)/config/global_planner.yaml" command="load"/>
    <rosparam file="$(find robot_dog_navigation)/config/costmap_common.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find robot_dog_navigation)/config/global_costmap.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find robot_dog_navigation)/config/costmap_common.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find robot_dog_navigation)/config/local_costmap.yaml"
              command="load" ns="local_costmap"/>
    </node>
  </group>

  <node pkg="robot_dog_teleop" type="oumax_cmd_vel_bridge.py"
        name="oumax_cmd_vel_bridge" output="screen">
    <param name="enable_motion" value="$(arg enable_motion)"/>
    <param name="cmd_vel_topic" value="/cmd_vel"/>
    <param name="drive_mode" value="dog"/>
    <param name="x_scale_ref" value="4.0"/>
    <param name="yaw_scale_ref" value="2.0"/>
    <param name="yaw_min_step" value="15"/>
    <param name="x_min_step" value="5"/>
    <param name="watchdog_sec" value="0.5"/>
  </node>
</launch>
