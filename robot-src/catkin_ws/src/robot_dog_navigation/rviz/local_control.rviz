Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Static Map1
        - /Global Costmap1
        - /Local Costmap (1m x 1m)1
        - /Lidar Point Cloud1
        - /Ball Detection Camera1
      Splitter Ratio: 0.5
    Tree Height: 650
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Nav Goal1
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncSource: ""
    SyncMode: 0
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Static Map
      Topic: /map
      Value: true
    - Alpha: 0.72
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Global Costmap
      Topic: /move_base/global_costmap/costmap
      Value: true
    - Alpha: 0.72
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Local Costmap (1m x 1m)
      Topic: /move_base/local_costmap/costmap
      Value: true
    - Class: rviz/PointCloud2
      Color: 255; 120; 0
      Enabled: true
      Name: Lidar Point Cloud
      Queue Size: 10
      Size (m): 0.045
      Style: Points
      Topic: /lidar_points
      Value: true
    - Class: rviz/LaserScan
      Color: 0; 255; 120
      Decay Time: 0.2
      Enabled: true
      Name: Lidar Scan
      Queue Size: 10
      Size (Pixels): 3
      Style: Points
      Topic: /scan
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Alpha: 0.9
      Marker Scale: 0.45
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /robot_body_marker
      Name: Robot Body (0.27m x 0.16m)
      Queue Size: 10
      Value: true
    - Alpha: 1
      Class: rviz/Path
      Color: 0; 90; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: Global Plan
      Topic: /move_base/GlobalPlanner/plan
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /cym_planner/map_image
      Name: Planner Map Image
      Transport Hint: raw
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /cym_planner/plan_image
      Name: Planner Plan Image
      Transport Hint: raw
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /ball_detector/image
      Name: Ball Detection Camera
      Transport Hint: raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top Down Ortho
      Scale: 4
      Target Frame: map
Window Geometry:
  Displays:
    collapsed: false
  Height: 920
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Width: 1440
  X: 80
  Y: 60
