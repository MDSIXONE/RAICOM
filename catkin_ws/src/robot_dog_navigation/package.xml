<?xml version="1.0"?>
<package format="2">
  <name>robot_dog_navigation</name>
  <version>0.1.0</version>
  <description>Offline local navigation demo for the robot dog. It never opens robot hardware or a remote ROS Master.</description>

  <maintainer email="1047840339@qq.com">RAICOM Team</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>global_planner</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>rviz</exec_depend>

  <export/>
</package>
